<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="use_sim_time" default="false"/>
  <arg name="vehicle_info_param_file" default="$(find-pkg-share c_car_vehicle_description)/config/vehicle_info.param.yaml"/>
  <node pkg="c_car_vehicle_description" exec="visual_joint_state_publisher.py"
        name="c_car_visual_joint_state_publisher" output="screen">
    <param from="$(var vehicle_info_param_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
