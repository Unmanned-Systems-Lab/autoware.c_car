Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 22; 27; 34
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 100
    - Class: rviz_default_plugins/PointCloud2
      Name: Reference map
      Enabled: true
      Topic:
        Value: /map/pointcloud_map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Style: Points
      Size (Pixels): 2
    - Class: rviz_default_plugins/PointCloud2
      Name: NDT aligned scan
      Enabled: true
      Topic:
        Value: /localization/pose_estimator/points_aligned
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 170; 40
      Style: Points
      Size (Pixels): 3
    - Class: rviz_default_plugins/Odometry
      Name: Universe vehicle pose
      Enabled: true
      Topic:
        Value: /localization/kinematic_state
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Keep: 2
      Shape:
        Value: Arrow
        Color: 0; 220; 255
        Length: 1
    - Class: rviz_default_plugins/Axes
      Name: Robot axes
      Enabled: true
      Reference Frame: base_link
      Length: 1
      Radius: 0.025
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Covariance x: 1
      Covariance y: 1
      Covariance yaw: 0.121869
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Target Frame: map
      Distance: 25
      Pitch: 0.65
      Yaw: 0.8
      Focal Point:
        X: -2
        Y: 0
        Z: 0
Window Geometry:
  Width: 1400
  Height: 900
